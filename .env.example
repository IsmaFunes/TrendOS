# Convex (from `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk — create an app at https://dashboard.clerk.com
# Enable the Convex JWT template named "convex"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Also set in Convex dashboard:
# CLERK_JWT_ISSUER_DOMAIN=https://YOUR_INSTANCE.clerk.accounts.dev

# Mercado Libre developer app (https://developers.mercadolibre.com)
# Prefer refresh token flow; ACCESS_TOKEN alone works for short tests
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=
MERCADOLIBRE_REFRESH_TOKEN=
MERCADOLIBRE_ACCESS_TOKEN=

# SerpAPI for Google Trends (optional — falls back to estimate)
SERPAPI_API_KEY=

# Gemini for web buzz research + match + rationales (optional — skips web signal without key)
GEMINI_API_KEY=
