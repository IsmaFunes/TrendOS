# Convex (from `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk — create an app at https://dashboard.clerk.com
# Enable the Convex JWT template named "convex"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Also set in Convex dashboard:
# CLERK_JWT_ISSUER_DOMAIN=https://YOUR_INSTANCE.clerk.accounts.dev

# ─── TrendOS MVP (Argentina + Meta Ad Library scrape) ──────────
TREND_RADAR_COUNTRY=AR
TREND_RADAR_DEFAULT_CURRENCY=ARS
# Default: meta_ad_library only (no Gemini/SerpAPI in the hot path)
TREND_RADAR_SOURCES=meta_ad_library

# Shared secret for the scrape worker → Convex ingest mutation
# Also: npx convex env set META_ADS_INGEST_SECRET "..."
META_ADS_INGEST_SECRET=
CONVEX_URL=

# Optional residential proxy for the Playwright worker
# META_ADS_PROXY_SERVER=http://user:pass@host:port

# Gemini — personaliza ranking de ads + sugiere términos de scrape
# Also: npx convex env set GEMINI_API_KEY "..."
# GEMINI_API_KEY=

# Optional / not required for MVP happy path:
# SERPAPI_API_KEY=
# MERCADOLIBRE_CLIENT_ID=
# MERCADOLIBRE_CLIENT_SECRET=
# MERCADOLIBRE_REFRESH_TOKEN=
